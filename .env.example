# PulseAPI Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=pulseapi-insecure-dev-key-change-in-production-observability-engine-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL by default in Docker / Production; defaults to SQLite if DB_NAME is empty)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pulseapi
DB_USER=pulseapi
DB_PASSWORD=pulseapipass
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SSRF Protection
# WARNING: Keep False in production! Only set True in local unit tests or isolated test fixtures.
SSRF_ALLOW_PRIVATE_IPS=False
SSRF_MAX_RESPONSE_BYTES=2097152
SSRF_DEFAULT_TIMEOUT_SECONDS=10

# Retention Policy (days of check records to keep before pruning)
CHECK_RETENTION_DAYS=30

# Email Alerts (Optional SMTP config)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alerts@pulseapi.dev
